[node name="Controls" type="Label" parent="Center/Panel/Columns"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 1, 0.45, 1)
theme_override_font_sizes/font_size = 16
text = "УДИРДЛАГА

W / S        өгсөх / буух
F            эргэж буцах
E / Q        түлхэлт нэмэх / хасах
SPACE        их буу
B            бомб хаях
M            Maverick пуужин харвах
T            дараагийн бай
X            хуурамч бай (ЗУП-ээс зайлсхийх!)
G            буух дугуй
Z            агаарын / дугуйн тоормос
V            онилох камер

P / ESC      түр зогсоох
R            дахин эхлэх
H            тусламж харуулах / нуух

ЗӨВЛӨГӨӨ: пуужингийн дохио дуугарвал
X дарж хуурамч бай хаяад огцом эргэ."

