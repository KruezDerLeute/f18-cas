[node name="Briefing" type="Label" parent="Center/Panel/Columns/Main"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 17
text = "Дайсны танк, ачааны машин, зенит БАРУУН талаас давшиж байна.
НОГООН УТААНЫ дэргэдэх манай танкуудыг хамгаал.
Нэмэлт хүч ирэх хүртэл довтолгоонуудыг няцаа."
horizontal_alignment = 1

