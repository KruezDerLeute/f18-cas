[node name="Controls" type="Label" parent="Center/Panel/Columns"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 1, 0.45, 1)
theme_override_font_sizes/font_size = 16
text = "CONTROLS

W / S        pull up / push down
F            flip (turn around)
E / Q        throttle up / down
SPACE        cannon
B            drop bomb
M            fire Maverick missile
T            next target
X            flares (dodge SAMs!)
G            landing gear
Z            speedbrake / wheel brakes
V            targeting camera

P / ESC      pause
R            restart
H            show / hide help

TIP: when a missile warning sounds,
press X for flares and turn hard."

